  "metadata": {
    "deck_name": "Chemistry Reactivity — Standard Classroom Set",
    "description": "A 35-card deck built from 22 element types. H×3 and O×5 as top reaction hubs, duplicates for high-connectivity elements (C×2, N×2, S×2, Na×2, K×2, Ca×2, Fe×2), and singles for others (Zn, Cu, Cl, Li, Mg, Al, Ag, B, Si, F, Br, I, P). Legal plays: match by group OR play any set of 2–4 distinct elements that forms a real compound family.",
    "rules_notes": [
      "Multi-card plays may include at most one of each element type (no stoichiometric repeats)."
    ],
    "last_updated": "2025-10-21T12:50:40.682729Z"
  },
